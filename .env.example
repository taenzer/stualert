HUSQVARNA_TOKEN_URL=https://api.authentication.husqvarnagroup.dev/v1/oauth2/token
HUSQVARNA_API_BASE_URL=https://api.amc.husqvarna.dev/v1
HUSQVARNA_WEBSOCKET_URL=wss://ws.openapi.husqvarna.dev/v1
HUSQVARNA_CLIENT_ID=your_client_id
HUSQVARNA_CLIENT_SECRET=your_client_secret
MOWER_ID=f1f459ea-6977-440e-9b8c-ee9225505fa0

# Basic Auth (protects UI + /api/*, except /health)
# If these are empty, auth is disabled (not recommended for deployment).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Comma-separated IPv4 CIDRs that bypass Basic Auth (e.g. WireGuard network)
AUTH_BYPASS_CIDRS=10.8.0.0/24